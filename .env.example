# Postgres connection string. When running via `docker compose`, host "postgres"
# resolves to the postgres service; for local (non-Docker) dev, point this at
# a Postgres instance reachable from your machine.
DATABASE_URI=postgresql://payload:payload@127.0.0.1:5432/cogwebsite

# Long random string used to sign auth tokens — generate a fresh one per
# environment, never reuse the example value.
PAYLOAD_SECRET=YOUR_SECRET_HERE

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Production only (docker-compose.yml) ---

# Your real domain once DNS points at the server — Caddy uses this to get an
# automatic HTTPS certificate. Leave unset for local/staging testing.
# SITE_DOMAIN=cityofgodchristiancentre.org

# Resend (https://resend.com), for sending real email (password resets, and
# notifications when a prayer request or enquiry form is submitted). Without
# RESEND_API_KEY set, emails are just logged to the console instead — fine
# for local dev. Get an API key from resend.com, and verify your sending
# domain there before going live (otherwise Resend limits you to sending
# only to your own account's email address).
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=no-reply@cityofgodchristiancentre.org
# EMAIL_FROM_NAME=City of God Christian Centre

# Where prayer request / contact / appointment / membership notifications get
# emailed. Without this set, no notification email is sent (submissions are
# still saved and visible in /admin either way).
# NOTIFY_EMAIL=office@cityofgodchristiancentre.org

# Stripe (https://stripe.com), for online giving. Without STRIPE_SECRET_KEY
# set, the "Give Online" button falls back to onlineGiving.url (Settings ->
# Giving) or a "coming soon" message. Start with TEST MODE keys (no business
# verification needed) from the Stripe dashboard -> Developers -> API keys;
# switch to live keys only once you're ready to accept real payments.
# STRIPE_SECRET_KEY=sk_test_...
#
# Signing secret for the webhook that marks a donation as paid and sends the
# donor's confirmation email — Stripe dashboard -> Developers -> Webhooks ->
# add an endpoint for <your domain>/api/stripe/webhook, select the events
# checkout.session.completed and invoice.paid. For local testing, the Stripe
# CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`) prints
# a temporary secret you can use instead.
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel deployment only (alternative to self-hosted docker-compose.yml) ---

# Media uploads (images, sermon files, etc.) go to Vercel Blob storage instead
# of local disk when this is set — required on Vercel, since serverless
# functions have no persistent disk. Vercel injects this automatically once
# you enable Blob storage for the project; you don't set it by hand.
# BLOB_READ_WRITE_TOKEN=
