# Postgres connection string. When running via `docker compose`, host "postgres"
# resolves to the postgres service; for local (non-Docker) dev, point this at
# a Postgres instance reachable from your machine.
DATABASE_URI=postgresql://payload:payload@127.0.0.1:5432/cogwebsite

# Long random string used to sign auth tokens — generate a fresh one per
# environment, never reuse the example value.
PAYLOAD_SECRET=YOUR_SECRET_HERE

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# SMTP + on-demand revalidation secret are added in a later phase.
